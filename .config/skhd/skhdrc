# skhd config — pairs with a SIP-enabled yabai setup.
#
# Modifier scheme:
#   alt          → focus / act on a window
#   shift + alt  → move a window
#   ctrl + alt   → resize & space layout
#
# Space SWITCHING is not bound here: `yabai -m space --focus` requires SIP to be
# partially disabled on macOS 13+. Use the native macOS shortcuts instead —
# System Settings → Keyboard → Keyboard Shortcuts → Mission Control →
# "Switch to Desktop N" (bind them to ctrl - 1..5).

# ── focus window (falls through to the display in that direction) ─────────
alt - h : yabai -m window --focus west  || yabai -m display --focus west
alt - j : yabai -m window --focus south || yabai -m display --focus south
alt - k : yabai -m window --focus north || yabai -m display --focus north
alt - l : yabai -m window --focus east  || yabai -m display --focus east

alt - g    : yabai -m window --focus first
alt - 0x29 : yabai -m window --focus last     # 0x29 is the ';' key

# ── move / swap windows within the space ──────────────────────────────────
shift + alt - h : yabai -m window --swap west
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - l : yabai -m window --swap east

# warp = re-insert, splitting the target window instead of swapping with it
shift + ctrl - h : yabai -m window --warp west
shift + ctrl - j : yabai -m window --warp south
shift + ctrl - k : yabai -m window --warp north
shift + ctrl - l : yabai -m window --warp east

# ── move windows between displays ─────────────────────────────────────────
ctrl + alt - h : yabai -m window --display west  && yabai -m display --focus west
ctrl + alt - j : yabai -m window --display south && yabai -m display --focus south
ctrl + alt - k : yabai -m window --display north && yabai -m display --focus north
ctrl + alt - l : yabai -m window --display east  && yabai -m display --focus east

# ── resize ────────────────────────────────────────────────────────────────
ctrl + alt - left  : yabai -m window --resize left:-60:0   || yabai -m window --resize right:-60:0
ctrl + alt - right : yabai -m window --resize left:60:0    || yabai -m window --resize right:60:0
ctrl + alt - down  : yabai -m window --resize bottom:0:60  || yabai -m window --resize top:0:60
ctrl + alt - up    : yabai -m window --resize bottom:0:-60 || yabai -m window --resize top:0:-60

ctrl + alt - e : yabai -m space --balance

# ── float / fullscreen ────────────────────────────────────────────────────
shift + alt - space : yabai -m window --toggle float && yabai -m window --grid 6:6:1:1:4:4
alt - f             : yabai -m window --toggle zoom-parent
shift + alt - f     : yabai -m window --toggle zoom-fullscreen

# ── splits & layout ───────────────────────────────────────────────────────
alt - e : yabai -m window --toggle split

ctrl + alt - r : yabai -m space --rotate 270
ctrl + alt - x : yabai -m space --mirror x-axis
ctrl + alt - y : yabai -m space --mirror y-axis

# toggle gaps/padding on the current space
ctrl + alt - g : yabai -m space --toggle padding && yabai -m space --toggle gap

# ── stacks ────────────────────────────────────────────────────────────────
# set the insertion point: the NEXT window into this space joins as a stack
shift + alt - s : yabai -m window --insert stack

# merge an ALREADY-OPEN neighbour into a stack with this window
ctrl + alt - s  : yabai -m window --stack west || yabai -m window --stack prev

# `next`/`prev` walk yabai's BSP tree, which can drift out of sync with macOS on
# a SIP-enabled setup (windows moved between spaces without the scripting
# addition). `recent` uses focus history, so it resolves even then.
alt - n         : yabai -m window --focus stack.next  || yabai -m window --focus next || yabai -m window --focus recent
shift + alt - n : yabai -m window --focus stack.prev  || yabai -m window --focus prev || yabai -m window --focus recent

# straight alt-tab between the two most recently focused windows
alt - tab : yabai -m window --focus recent

# ── REQUIRES SIP PARTIALLY DISABLED ───────────────────────────────────────
# `space --focus` and `window --space` both need the scripting addition on
# macOS 13+. Uncomment these only after disabling SIP and running --load-sa.
#
# alt - 1 : yabai -m space --focus 1
# alt - 2 : yabai -m space --focus 2
# alt - 3 : yabai -m space --focus 3
# alt - 4 : yabai -m space --focus 4
# alt - 5 : yabai -m space --focus 5
#
# shift + alt - 1 : yabai -m window --space 1 && yabai -m space --focus 1
# shift + alt - 2 : yabai -m window --space 2 && yabai -m space --focus 2
# shift + alt - 3 : yabai -m window --space 3 && yabai -m space --focus 3
# shift + alt - 4 : yabai -m window --space 4 && yabai -m space --focus 4
# shift + alt - 5 : yabai -m window --space 5 && yabai -m space --focus 5
#
# alt - c : yabai -m space --create
# alt - x : yabai -m space --destroy
# alt - t : yabai -m window --toggle sticky
